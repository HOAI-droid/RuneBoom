{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "runeBOOM",
  "version": "0.8.3",
  "identifier": "io.github.hoaidroid.runeboom",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "runeBOOM · Die Feste der Erfinder", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 600, "resizable": true, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "StrategyGame",
    "shortDescription": "Episches Fantasy-Tower-Defense in Voxeln",
    "longDescription": "Am Tag bauen und erfinden, in der Nacht bestehen. 40 Nächte, vier Akte, drei Völker.",
    "copyright": "HOAI-droid",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
